# ==============================================================================
# Alpha Squared IoT Health Monitoring System - Environment Configuration
# Mode: LIVE SENSOR MONITORING ONLY (No MongoDB persistent storage required)
# ==============================================================================
# Copy this file to .env for local testing, or configure these variables
# directly in your Vercel Project Settings (Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Upstash Redis / Vercel KV REST API (REQUIRED for Multi-Invocation Vercel Sync)
# ------------------------------------------------------------------------------
# Free tier Key-Value storage integration for sharing live sensor state across Vercel functions.
# Obtainable from Vercel Marketplace (Storage -> Upstash Redis) or console.upstash.com (Free)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Alternatively, Vercel KV environment variables (automatically injected if using Vercel KV):
# KV_REST_API_URL=https://your-kv-url.kv.vercel-storage.com
# KV_REST_API_TOKEN=your_kv_rest_token_here

# ------------------------------------------------------------------------------
# 2. Administrative Security (REQUIRED for Production API Administration)
# ------------------------------------------------------------------------------
# Master secret key required for administrative device registration, deletion, and token rotation
ADMIN_API_KEY=your_secure_admin_api_key_here

# ------------------------------------------------------------------------------
# 3. Device Secret Token Configuration (OPTIONAL - Defaults to built-in default token)
# ------------------------------------------------------------------------------
# Device token for ALPHA-001 device authentication
DEVICE_TOKEN_ALPHA_001=alphadev_alpha001_secret_token_2026

# ------------------------------------------------------------------------------
# 4. Emergency Gmail Alert Service (OPTIONAL for Emergency Email Dispatch)
# ------------------------------------------------------------------------------
# Gmail SMTP credentials for automated emergency alert emails (Nodemailer)
# Never expose these credentials in frontend JavaScript.
GMAIL_SENDER=your-sender-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
GMAIL_RECEIVER=caregiver-or-doctor-email@gmail.com

# ------------------------------------------------------------------------------
# 5. Emergency Telegram Dispatch Service (OPTIONAL for Telegram Alerts)
# ------------------------------------------------------------------------------
# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Telegram Chat ID of the Caregiver or Emergency Channel
TELEGRAM_CAREGIVER_CHAT_ID=-100123456789
