# ==============================================================================
# Alpha Squared IoT Health Monitoring System - Environment Configuration
# ==============================================================================
# Copy this file to .env for local development, or configure these variables
# directly in your Vercel Project Settings (Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection URI from your MongoDB Atlas cluster (Connect -> Drivers -> Node.js)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Target database name (defaults to 'alpha_squared_iot' if omitted)
MONGODB_DB_NAME=alpha_squared_iot

# ------------------------------------------------------------------------------
# 2. Administrative Security
# ------------------------------------------------------------------------------
# Secret master key required for administrative device registration, deletion, and token rotation.
# Must be set securely in production.
ADMIN_API_KEY=your_secure_admin_api_key_here

# ------------------------------------------------------------------------------
# 3. Emergency Gmail Alert Service (Nodemailer)
# ------------------------------------------------------------------------------
# Credentials for the emergency dispatch system.
# Never expose these credentials in frontend JavaScript.
GMAIL_SENDER=your-sender-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
GMAIL_RECEIVER=caregiver-or-doctor-email@gmail.com

# ------------------------------------------------------------------------------
# 4. Optional Webhook & Notification Providers
# ------------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
