{
  "version": 2,
  "name": "alpha-squared-backend",
  "functions": {
    "api/send-telegram-alert.js": {
      "memory": 128,
      "maxDuration": 10
    },
    "api/send-email-alert.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}